---
import Layout from "../../layouts/Layout.astro";
import AdminControlNav from "../../components/AdminControlNav.astro";
import AdminPasswordAdmin from "../../components/AdminPasswordAdmin.jsx";
import { hasAdminPasswordHash } from "../../lib/admin-auth.js";

const hasExistingPassword = await hasAdminPasswordHash();
---

<Layout title="Admin Panel - Password">
  {hasExistingPassword && <AdminControlNav active="password" />}
  <AdminPasswordAdmin hasExistingPassword={hasExistingPassword} client:load />
</Layout>
